{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Compila TheKnife",
        "type": "shell",
        "command": "javac",
        "args": [
          "-d",
          "bin",
          "${workspaceFolder}/src/theknife/*.java",
          "${workspaceFolder}/src/theknife/gui/*.java",
          "${workspaceFolder}/src/theknife/gui/panels/*.java"
        ],
        "group": {
          "kind": "build",
          "isDefault": true
        }
      }
    ]
  }
  